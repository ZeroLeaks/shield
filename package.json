{
  "name": "@zeroleaks/shield",
  "version": "2.0.0",
  "description": "Runtime security for LLM apps and agents: prompt injection detection for user input and tool results, and leak, credential, PII, and exfiltration checks on model output",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./openai": {
      "types": "./dist/providers/openai.d.ts",
      "import": "./dist/providers/openai.mjs",
      "require": "./dist/providers/openai.js"
    },
    "./anthropic": {
      "types": "./dist/providers/anthropic.d.ts",
      "import": "./dist/providers/anthropic.mjs",
      "require": "./dist/providers/anthropic.js"
    },
    "./ai-sdk": {
      "types": "./dist/providers/ai-sdk.d.ts",
      "import": "./dist/providers/ai-sdk.mjs",
      "require": "./dist/providers/ai-sdk.js"
    },
    "./groq": {
      "types": "./dist/providers/groq.d.ts",
      "import": "./dist/providers/groq.mjs",
      "require": "./dist/providers/groq.js"
    },
    "./google": {
      "types": "./dist/providers/google.d.ts",
      "import": "./dist/providers/google.mjs",
      "require": "./dist/providers/google.js"
    },
    "./mistral": {
      "types": "./dist/providers/mistral.d.ts",
      "import": "./dist/providers/mistral.mjs",
      "require": "./dist/providers/mistral.js"
    },
    "./langchain": {
      "types": "./dist/providers/langchain.d.ts",
      "import": "./dist/providers/langchain.mjs",
      "require": "./dist/providers/langchain.js"
    },
    "./mcp": {
      "types": "./dist/providers/mcp.d.ts",
      "import": "./dist/providers/mcp.mjs",
      "require": "./dist/providers/mcp.js"
    },
    "./openai-agents": {
      "types": "./dist/providers/openai-agents.d.ts",
      "import": "./dist/providers/openai-agents.mjs",
      "require": "./dist/providers/openai-agents.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.mjs",
      "require": "./dist/model.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.mjs",
      "require": "./dist/local.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "test:integration": "bunx vitest run --config vitest.integration.config.ts",
    "benchmark": "bun run scripts/benchmark.ts",
    "serve": "bun run src/server/cli.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zeroleaks/shield"
  },
  "homepage": "https://zeroleaks.ai/docs/shield-sdk",
  "bugs": {
    "url": "https://github.com/zeroleaks/shield/issues"
  },
  "keywords": [
    "llm",
    "security",
    "prompt-injection",
    "ai-safety",
    "openai",
    "anthropic",
    "gemini",
    "mistral",
    "langchain",
    "jailbreak",
    "ai-agents",
    "agent-security",
    "mcp",
    "openai-agents",
    "tool-poisoning",
    "guardrails",
    "dlp",
    "secrets-detection",
    "pii",
    "canary",
    "ai-sdk"
  ],
  "license": "MIT",
  "peerDependencies": {
    "openai": ">=4.0.0",
    "@anthropic-ai/sdk": ">=0.20.0",
    "ai": ">=3.0.0",
    "groq-sdk": ">=0.3.0",
    "@google/genai": ">=1.0.0",
    "@mistralai/mistralai": ">=1.0.0",
    "@langchain/core": ">=0.3.0",
    "@modelcontextprotocol/sdk": ">=1.0.0",
    "@openai/agents": ">=0.3.8",
    "@huggingface/transformers": "^3.8.1"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "groq-sdk": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "@mistralai/mistralai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/openai": "^3.0.33",
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/genai": "^2.24.0",
    "@huggingface/transformers": "^3.8.1",
    "@langchain/core": "^1.2.12",
    "@mistralai/mistralai": "^2.7.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@openai/agents": "^0.18.0",
    "@types/node": "^26.1.1",
    "ai": "^7.0.127",
    "ai-v4": "npm:ai@^4.3.19",
    "ai-v5": "npm:ai@^5.0.267",
    "ai-v6": "npm:ai@^6.0.292",
    "groq-sdk": "^0.37.0",
    "openai": "^6.25.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
